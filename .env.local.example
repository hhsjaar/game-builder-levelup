# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# Server-only. From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5 if unset. Set to claude-sonnet-5 for lower cost.
GAME_GEN_MODEL=claude-opus-5

# From your Supabase project settings > API. The URL is public (safe to expose to
# the browser), the service role key is server-only and must NEVER be exposed
# with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
