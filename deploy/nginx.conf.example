# Nginx reverse proxy for game-prompt-studio, running via PM2 on 127.0.0.1:3001
# (see ../ecosystem.config.js — 3001, not 3000, because this VPS already runs
# another PM2 app named auto-video-editor on 3000). This server block is
# additive: it does not touch the existing editor.burjolevelup.com or
# harusnyalotau.website blocks already in /etc/nginx/sites-enabled/.
#
# Copy to /etc/nginx/sites-available/game-prompt-studio, fill in your
# subdomain, then:
#   sudo ln -s /etc/nginx/sites-available/game-prompt-studio /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d your-subdomain.example.com   # adds HTTPS + redirect on top of this
#
# The long proxy_*_timeout values are the whole point of moving off Vercel:
# game generation can legitimately take several minutes, and Nginx's default
# 60s read timeout would kill it long before Claude finishes.
server {
    listen 80;
    server_name your-subdomain.example.com;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # No hard ceiling like Vercel's 300s — set generously and let the
        # app's own logic (buildUserPrompt/generateGameHtml) be the limit.
        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
